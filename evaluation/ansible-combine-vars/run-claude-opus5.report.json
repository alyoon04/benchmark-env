  "diff": "diff --git b/changelogs/fragments/vars_with_sources_union.yml b/changelogs/fragments/vars_with_sources_union.yml\nnew file mode 100644\nindex 0000000..2870faa\n--- /dev/null\n+++ b/changelogs/fragments/vars_with_sources_union.yml\n@@ -0,0 +1,4 @@\n+bugfixes:\n+  - \"``VarsWithSources`` now supports the union operators (``|``, ``|=``) with other mappings,\n+    fixing a ``TypeError`` when combining a ``dict`` with ``VarsWithSources`` in ``combine_vars``\n+    while ``DEFAULT_HASH_BEHAVIOUR=replace``.\"\ndiff --git a/lib/ansible/vars/manager.py b/lib/ansible/vars/manager.py\nindex 93a1b9a..9dca777 100644\n--- a/lib/ansible/vars/manager.py\n+++ b/lib/ansible/vars/manager.py\n@@ -784,5 +784,24 @@ class VarsWithSources(MutableMapping):\n     def __contains__(self, key):\n         return self.data.__contains__(key)\n \n+    def __or__(self, other):\n+        ''' Return a new mapping with the union of this mapping and other, other takes precedence '''\n+        if not isinstance(other, MutableMapping):\n+            return NotImplemented\n+        return self.data | dict(other)\n+\n+    def __ror__(self, other):\n+        ''' Return a new mapping with the union of other and this mapping, this mapping takes precedence '''\n+        if not isinstance(other, MutableMapping):\n+            return NotImplemented\n+        return dict(other) | self.data\n+\n+    def __ior__(self, other):\n+        ''' Update this mapping in place with the contents of other, other takes precedence '''\n+        if not isinstance(other, MutableMapping):\n+            return NotImplemented\n+        self.data |= dict(other)\n+        return self\n+\n     def copy(self):\n         return VarsWithSources.new_vars_with_sources(self.data.copy(), self.sources.copy())\n",
